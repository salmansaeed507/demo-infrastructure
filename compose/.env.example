# Copy to .env on the VPS (/opt/demo/.env) and fill in secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=demo

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/demo
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
# Chat model for customer-support-agent. gpt-5.4-nano is ~4x cheaper than mini;
# if you change it, also set LLM_*_USD_PER_MTOK so the cost badge stays right.
LLM_MODEL=gpt-5.4-mini
LOGIN_TOKEN=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=
SESSION_IDLE_SECONDS=86400
# Default every 2 hours; use "* * * * *" for every minute locally
PURGE_INACTIVE_SESSIONS_CRON=0 */2 * * *
CORS_ORIGINS=https://demo.salmansaeed507.com
# Internal URL the gateway proxies /support/* to (not the public site)
CUSTOMER_SUPPORT_URL=http://customer-support-agent:8000
LOG_LEVEL=INFO

API_GATEWAY_TAG=latest
CUSTOMER_SUPPORT_TAG=latest
FRONTEND_TAG=latest

API_GATEWAY_PORT=5070
